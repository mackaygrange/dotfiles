[global]
    geometry = "512x3-10+10"
    shrink = false
    transparency = 25
    notification_height = 50
    seperator_height = 10 
    padding = 10
    horizontal_padding = 10
    frame_width = 0
    font = "Cascadia Code NF 12"
    line_height = 2
    alignment = center
    vertical_alignment = center
    word_wrap = true
    icon_position = off
    corner_radius = 0
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita"
    background = "#393552"
    foreground = "#e0def4"

[urgency_low]
    background = "#393955"
    highlight = "#3e8fb0"
    frame_color = "#3e8fb0"
    default_icon = "dialog-information"
    format = "<b><span foreground='#3e8fb0'>%s</span></b>\n%b"

[urgency_normal]
    background = "#443c53"
    highlight = "#f6c177"
    frame_color = "#f6c177"
    default_icon = "dialog-warning"
    format = "<b><span foreground='#f6c177'>%s</span></b>\n%b"

[urgency_critical]
    background = "#433754"
    highlight = "#eb6f92"
    frame_color = "#eb6f92"
    default_icon = "dialog-error"
    format = "<b><span foreground='#eb6f92'>%s</span></b>\n%b"

