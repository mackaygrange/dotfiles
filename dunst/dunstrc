[global]
    geometry = "512x3-10+10"
    shrink = false
    transparency = 25
    notification_height = 50
    separator_height = 10 
    padding = 10
    horizontal_padding = 10
    frame_width = 0
    font = "Cascadia Code NF 12"
    line_height = 2
    alignment = center
    vertical_alignment = center
    word_wrap = true
    icon_position = off
    corner_radius = 5
    enable_recursive_icon_lookup = true
    icon_theme = "Adwaita"
    background = "#393552"
    foreground = "#ffffff"

[urgency_low]
    background = "#393552"
    highlight = "#ffffff"
    frame_color = "#3e8fb0"
    default_icon = "dialog-information"
    format = "<b><span foreground='#ffffff'>%s</span></b>\n%b"

[urgency_normal]
    background = "#393552"
    highlight = "#ffffff"
    frame_color = "#f6c177"
    default_icon = "dialog-warning"
    format = "<b><span foreground='#ffffff'>%s</span></b>\n%b"

[urgency_critical]
    background = "#393552"
    highlight = "#ffffff"
    frame_color = "#eb6f92"
    default_icon = "dialog-error"
    format = "<b><span foreground='#ffffff'>%s</span></b>\n%b"

