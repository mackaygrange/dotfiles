# ==-- i3 Settings --== #
set $mod Mod4
set $terminal kitty

set $ws1 "1:Browser"
set $ws2 "2:Local-Terminal"
set $ws3 "3:SSH-Terminal"
set $ws4 "4:Misc"
set $ws5 "5:"
set $ws6 "6:"
set $ws7 "7:"
set $ws8 "8:"
set $ws9 "9:"
set $ws10 "10:Costpoint"

set $refresh_i3status killall -SIGUSR1 i3status
floating_modifier $mod

# ==-- i3 Keybindings --== #
# Jump to workspace:
bindsym $mod+1 workspace number $ws1; bar mode dock
bindsym $mod+2 workspace number $ws2; bar mode dock
bindsym $mod+3 workspace number $ws3; bar mode dock
bindsym $mod+4 workspace number $ws4; bar mode dock
bindsym $mod+5 workspace number $ws5; bar mode dock
bindsym $mod+6 workspace number $ws6; bar mode dock
bindsym $mod+7 workspace number $ws7; bar mode dock
bindsym $mod+8 workspace number $ws8; bar mode dock
bindsym $mod+9 workspace number $ws9; bar mode dock
bindsym $mod+0 workspace number $ws10; bar mode dock

# Move focused container to workspace:
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Screenshot bindings:
bindsym --release $mod+Shift+s exec --no-startup-id scrot -b -f -s -l style=dash'%Y-%m-%d_$wx$h.png' -e 'mv $f ~/screenshots'
bindsym --release $mod+s exec --no-startup-id scrot -b -f -s -l style=dash - | xclip -selection clipboard -target image/png

# Misc bindings:
bindsym $mod+Return exec $terminal
bindsym $mod+Shift+q kill
bindsym $mod+r exec --no-startup-id rofi -show drun
bindsym $mod+w exec --no-startup-id rofi -show window

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+b layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+t exec i3-input -F "rename workspace to \"%s\"" -P "New workspace name: " -f "Cascadia Code NF 8"
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
bindsym $mod+m mode "resize"
bindsym Mod4+l exec "$HOME/repos/dotfiles/i3/lock.sh"
mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+m mode "default"
}

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status


# ==-- i3 Appearance Settings --== #
font pango:FiraCode Nerd Font 9

set $base           #262335A8
set $surface        #2e2a3eA8
set $overlay        #3b3654A8
set $muted          #6c678366
set $subtle         #848bbd66
set $text           #e0d9f5FF
set $love           #fe4450A8
set $gold           #fede5dFF
set $rose           #ff7edbA8
set $pine           #36f9f6A8
set $foam           #72f1b8A8
set $iris           #b893ceA8
set $highlightlow   #2e2a3e66
set $highlightmed   #3f3a5666
set $highlighthigh  #504a6e66

# target                title          bg             text     indicator border
client.focused          $highlightlow  $highlightlow  $text    $iris     $iris
client.focused_inactive $muted         $muted         $subtle  $muted    $muted
client.unfocused        $muted         $muted         $subtle  $muted    $muted
client.urgent           $highlightlow  $subtle        $text    $base     $rose
client.placeholder      $base          $base          $text    $base     $base
client.background       $base

for_window [all] border pixel 0
default_floating_border pixel 0px
gaps inner 5px
gaps outer 5px


# ==-- i3 Startup Settings --== #
# Initial Background Apps:
exec --no-startup-id picom --config ~/repos/dotfiles/picom/picom.conf -b
exec --no-startup-id dunst -conf ~/repos/dotfiles/dunst/dunstrc &
exec --no-startup-id xss-lock --transfer-sleep-lock ~/repos/dotfiles/i3/lock.sh --nofork

#Initial Linux Configurations:
exec --no-startup-id xset r rate 200 50
exec_always xrandr --output HDMI-1 --mode 1920x1080
exec_always xrandr --output HDMI-2 --mode 3440x1440 --primary

# Set background:
# Possible to play with these settings to acheive a desired effect.
exec --no-startup-id convert -size 5360x1440 -define gradient:radii=2440,720 -define gradient:angle=30 radial-gradient:"#ff7edb"-"#262335" $HOME/repos/dotfiles/wallpapers/gradient.png && hsetroot -root -fill $HOME/repos/dotfiles/wallpapers/gradient.png

# Initial Desktop Apps:
assign [window_role="browser"] $ws1
assign [title="Costpoint 8"] $ws10
assign [title="Local-Dev"] $ws2
assign [title="Remote-Dev"] $ws3
for_window [title="Costpoint 8"] move to workspace number $ws10
for_window [title="Local-Dev"] move to workspace number $ws2
for_window [title="Remote-Dev"] move to workspace number $ws3
# assign [class="kitty"] $ws2

workspace $ws1 output HDMI-1
workspace $ws10 output HDMI-1
workspace $ws2 output HDMI-2
workspace $ws3 output HDMI-2
workspace $ws4 output HDMI-2
workspace $ws5 output HDMI-2

# Screen 1:
exec --no-startup-id i3-msg "focus workspace number $ws1"
exec --no-startup-id microsoft-edge
exec --no-startup-id i3-msg "focus workspace number $ws10"
exec /opt/microsoft/msedge/microsoft-edge --profile-directory=Default --app-id=jhjafghdmibakmeimnmmkgglnjhgmomi --app-url=https://arkhamtechnology-cp.costpointfoundations.com/cpweb/costpoint.htm
exec --no-startup-id i3-msg "focus workspace number $ws1"

# Screen 2: (Main Display)
exec --no-startup-id i3-msg "focus workspace number $ws2"
exec --no-startup-id kitty --title "Local-Dev" /usr/bin/tmux new -sLocalDev
exec --no-startup-id i3-msg "focus workspace number $ws3"
exec --no-startup-id kitty --hold --title "Remote-Dev" /usr/bin/kitty +kitten ssh -X mgrange@192.168.66.158 -t 'tmux new -sRemote-Dev'

bar {
    i3bar_command i3bar --transparency
    status_command i3status -c /home/$USER/.config/i3status/i3status.conf
    font pango:FiraCode Nerd Font Propo Semibold 9
    # separator_symbol " 〈 "
    # separator_symbol " ≬ "
    # separator_symbol " ✞ "
    # separator_symbol " ♾ "
    separator_symbol " <=> "
    # separator_symbol " ☽ ☾ "
    # separator_symbol " ♦ "
    workspace_buttons yes
    workspace_min_width 50
    position bottom
    padding 2px
    output primary
    tray_output none
    tray_padding 0
    colors {
      background $base
      statusline $text
      separator $gold

      focused_background $overlay
      focused_statusline $text
      focused_separator $gold

      #                       border          background      text
      focused_workspace       $base           $base           $text
      inactive_workspace      $muted          $muted          $text
      urgent_workspace        $rose           $rose           $text
    }
}
