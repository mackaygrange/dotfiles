root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{sh,bash}]
indent_style = tab
indent_size = 4

[*.{lua,json,jsonc,css,rasi}]
indent_style = space
indent_size = 2

[*.{conf,cfg}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
