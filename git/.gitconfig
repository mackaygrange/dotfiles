[user]
name = Mackay Grange
email = mackay.grange@gmail.com

[core]
editor = nvim

[init]
defaultBranch = master

[pull]
rebase = true

[alias]
st = status
co = checkout
br = branch
cm = commit
lg = log --oneline --graph --decorate --all
df = diff
ds = diff --staged
